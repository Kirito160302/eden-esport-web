# === Connexion au back-office WordPress (headless) sur IONOS ===
# URL de la passerelle GraphQL exposée par l'extension WPGraphQL.
# Exemple : https://admin.eden-esport.fr/graphql
# Tant que cette variable est vide, le site fonctionne avec des DONNÉES DE DÉMONSTRATION.
WORDPRESS_API_URL=

# (Optionnel) URL publique du site, utilisée pour le SEO / Open Graph
NEXT_PUBLIC_SITE_URL=https://eden-esport.fr
